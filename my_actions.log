2026-11-18T06:43:45.082418Z	   38 Query	USE orders_norm
2026-11-18T06:43:45.082815Z	   38 Query	CREATE TABLE representatives (
    rep_id   INT          NOT NULL,
    rep_name VARCHAR(100) NOT NULL,
    PRIMARY KEY (rep_id)
)
2026-11-18T06:43:45.122289Z	   38 Query	CREATE TABLE products (
    product_id   INT           NOT NULL,
    product_name VARCHAR(100)  NOT NULL,
    price        DECIMAL(10,2) NOT NULL,
    PRIMARY KEY (product_id)
)
2026-11-18T06:43:45.156256Z	   38 Query	CREATE TABLE orders (
    order_id    INT  NOT NULL,
    order_date  DATE NOT NULL,
    customer_id INT  NOT NULL,
    rep_id      INT  NOT NULL,
    PRIMARY KEY (order_id),
    FOREIGN KEY (rep_id) REFERENCES representatives (rep_id)
)
2026-11-18T06:43:45.196527Z	   38 Query	CREATE TABLE order_items (
    order_id   INT NOT NULL,
    product_id INT NOT NULL,
    quantity   INT NOT NULL,
    PRIMARY KEY (order_id, product_id),
    FOREIGN KEY (order_id)   REFERENCES orders    (order_id),
    FOREIGN KEY (product_id) REFERENCES products (product_id)
)
